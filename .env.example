# Пример файла окружения. Скопируйте в .env и заполните под свой сервер
# (deploy.sh создаёт .env автоматически и подставляет правильный путь БД).

# База данных SQLite (правки админки, заявки, отзывы, статистика).
# Рекомендуется АБСОЛЮТНЫЙ путь — deploy.sh проставит его сам:
DATABASE_URL=file:/var/www/tbs/db/custom.db

# Пароль администратора /admin (по умолчанию tbs2026 — ОБЯЗАТЕЛЬНО смените).
ADMIN_PASSWORD=tbs2026

# Необязательно: отдельный секрет для подписи cookie админки.
# Если не задан — используется ADMIN_PASSWORD.
# ADMIN_SECRET=длинная-случайная-строка
